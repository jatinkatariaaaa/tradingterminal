# Risk worker environment. This service is server-only and uses the service-role
# key, which BYPASSES RLS. Never expose these values to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub API key for live price quotes (forex/commodities).
FINNHUB_API_KEY=

# Tick cadence in milliseconds (how often equity/breaches are recomputed).
RISK_TICK_MS=500

# Finnhub FX/metals poll interval in milliseconds.
FINNHUB_POLL_MS=15000

# Engine: v4 (default) or legacy (the pre-v4 loop; also used automatically if risk_cycle is missing).
RISK_ENGINE=v4
# Snapshot cadence while any position or order is open, and while the book is flat.
RISK_CYCLE_MS=2000
RISK_IDLE_CYCLE_MS=4000
# Equity and price writes, batched into one transaction.
RISK_PERSIST_MS=5000
